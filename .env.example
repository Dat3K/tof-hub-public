# ToF Hub configuration template.
# Do not copy this file by hand. Run `node scripts/setup.mjs`
# (or `docker compose --profile tools run --rm setup`): it creates `.env` from
# this template and fills every value marked [auto] with fresh random secrets.
# Full reference: docs/configuration.md

# --- Site: the defaults work for a local installation --------------------------
# Prefix for Docker container and volume names. Keep it stable once the site has data.
COMPOSE_PROJECT_NAME=tof-hub-public
# Public address of the site. Change both when you put it behind your own domain.
SITE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Port on this machine where the site is served (loopback only).
WEB_PORT=8080
# Optional bind address when running the API directly from the source checkout.
# API_HOST=127.0.0.1

# --- Database: [auto] filled by setup, leave as they are -----------------------
# Password of the schema owner (used only for migrations).
POSTGRES_PASSWORD=""
# Password of the restricted login the API uses.
RUNTIME_DB_PASSWORD=""
# Connection strings built from the two passwords above.
DATABASE_URL=""
DATABASE_MIGRATION_URL=""

# --- Secrets: [auto] filled by setup, keep them stable --------------------------
# Salt for anonymous per-IP counters.
IP_HASH_SALT=""
# Signs the site's cookies.
COOKIE_SECRET=""
# Key for the owner-only feedback endpoints.
FEEDBACK_ADMIN_KEY=""
# Public name of this installation's import key; the key itself is generated on first start.
WISH_IMPORT_KEY_ID=self-hosted-1

# --- Game data pipeline: only for the Docker raw-export workflow ---------------
# Folder that contains Hotta/Content from an existing raw export. Not needed when you use ToF Exporter.
RAW_GAME_DIR=./pipeline/raw
# Optional download URL of the bootstrap package, instead of placing it in ignore/downloads/.
TOF_BOOTSTRAP_URL=""

# --- Optional integrations: leave empty to disable -----------------------------
# Link to an external data collector shown on the site. Empty means JSON import only.
NEXT_PUBLIC_CAPTURE_APP_URL=""
# Telegram notifications: off, producer, relay or controller. See docs/configuration.md.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN="" # Optional; leave empty when Telegram is disabled.
TELEGRAM_OWNER_ID=""
TELEGRAM_RELAY_URL=""
TELEGRAM_RELAY_SECRET=""

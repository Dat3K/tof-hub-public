{
  "name": "tof-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "generate:runtime-data": "node scripts/generators/build-runtime-data.cjs",
    "generate:build-page": "node scripts/generators/build-card.cjs --page && pnpm generate:summaries",
    "generate:build-progression": "node scripts/generators/build-progression-costs.cjs",
    "generate:build-loadout-progression": "node scripts/generators/build-loadout-progression.cjs",
    "generate:build-cs-research": "node scripts/generators/build-cs-research.cjs",
    "generate:build-temporary-attack": "node scripts/generators/build-temporary-attack-effects.cjs",
    "generate:mmo-food": "node scripts/generators/build-mmo-food.cjs",
    "generate:mmo-card": "node scripts/generators/build-mmo-card.cjs",
    "generate:title-styles": "node scripts/generators/build-title-styles.cjs",
    "generate:build-supercomputing": "node scripts/generators/build-supercomputing.cjs",
    "generate:build-space-support": "node scripts/generators/build-supercomputing.cjs",
    "generate:handbook": "node scripts/generators/build-handbook.cjs",
    "generate:hub-summary": "node scripts/generators/build-hub-summary.cjs",
    "generate:summaries": "node scripts/generators/build-handbook.cjs --supercomputer-from-build && node scripts/generators/build-hub-summary.cjs && node scripts/generators/build-runtime-data.cjs",
    "generate:main-hub": "node --import tsx scripts/generators/build-main-hub.cjs",
    "generate:version-tracker": "node scripts/generators/build-version-tracker.cjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "check:localization": "node scripts/checks/check-ui-localization.cjs",
    "lint": "pnpm check:localization && turbo run lint",
    "typecheck": "turbo run typecheck --filter=!@tof-hub/tof-exporter",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "feedback:export": "node --import tsx scripts/feedback/export.ts",
    "test:e2e": "playwright test",
    "postinstall": "node -e \"if (require('fs').existsSync('apps/api/prisma/schema.prisma')) require('child_process').execSync('pnpm --filter api prisma:generate', {stdio: 'inherit'})\"",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:validate": "pnpm --filter api prisma:validate",
    "normalize:game-data": "tsx scripts/normalize-game-data/index.ts && pnpm generate:summaries",
    "normalize:wish-banners": "tsx scripts/normalize-game-data/wish-only.ts",
    "build:data-manifest": "tsx scripts/build-data-manifest/index.ts",
    "generate:wish-media-map": "tsx scripts/generate-wish-media-map/index.ts",
    "generate:wish-demo": "tsx scripts/normalize-game-data/generate-wish-demo.ts",
    "validate:generated": "tsx scripts/validate-generated/index.ts",
    "test:pipeline-fixture": "tsx scripts/validate-generated/pipeline-fixture.ts",
    "generate:fce-cards": "node scripts/generators/build-fce-cards.cjs",
    "generate:link-previews": "node scripts/generators/build-link-previews.cjs",
    "validate:import-examples": "tsx scripts/validate-import-examples.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "eslint": "10.11.0",
    "jsdom": "^30.1.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "@types/node": "24.13.6"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  }
}

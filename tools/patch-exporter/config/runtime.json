{
  "name": "tof-exporter-runtime-manifest",
  "version": "1.0.0",
  "description": "Authoritative pinned versions, checksums, and asset URLs for portable exporter runtimes",
  "runtimes": {
    "node": {
      "name": "Node.js",
      "version": "24.15.0",
      "channel": "LTS",
      "codename": "Krypton",
      "platform": "win32",
      "arch": "x64",
      "fileName": "node-v24.15.0-win-x64.zip",

        },
        {
          "name": "oodle-data-shared.dll",
          "sha256": "8f6c0d487573b5a7ea8548407cbf96f5cd833fe7138769914961b6697d74b3b3"
        },
        {
          "name": "zlib-ng2.dll",
          "sha256": "454be2f3d10f804ace577198401431db5e95d0286b59589bc28a40085388e7c2"
        }
      ],
      "runtimeDllsNote": "CUE4Parse loads these from the exe folder and downloads them when absent. Package with TOF_UNREAL_RUNTIME_DIR=<folder with the verified DLLs> for offline use."
    }
  },
  "packageConfig": {
    "outputDir": "dist/tof-exporter-portable",
    "archiveName": "tof-exporter-portable.zip",
    "bundledRuntimePath": "runtime/node.exe",
    "entrypoints": {
      "exportBat": "export.bat",
      "processExistingBat": "process-existing.bat",
      "validateBat": "validate.bat",
      "runBat": "RUN.bat"
    }
  }
}

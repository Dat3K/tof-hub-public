      "internalArchivePaths": {
        "binary": "node-v24.15.0-win-x64/node.exe",
        "license": "node-v24.15.0-win-x64/LICENSE"
      },
      "targetPackagePaths": {
        "binary": "runtime/node.exe",
        "license": "runtime/NODE_LICENSE"

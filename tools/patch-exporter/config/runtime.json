      "version": "2.0.0",
      "repo": "https://github.com/luk-gg/UnrealExporter",
      "fileName": "UnrealExporter-2.0.0.zip",
      "url": "https://github.com/luk-gg/UnrealExporter/releases/download/v2.0.0/UnrealExporter-2.0.0.zip",
      "sha256": "7cf97b4fc66f8007a07b3657a4110542501e8bf5a1d45dc3e4d0ccd5fde82b58",
